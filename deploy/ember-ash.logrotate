# =============================================================================
# Logrotate Configuration: Ember & Ash Application Logs
# Target OS: Amazon Linux 2023 (/etc/logrotate.d/ember-ash)
# =============================================================================

/var/log/ember-ash/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0644 ec2-user ec2-user
}
