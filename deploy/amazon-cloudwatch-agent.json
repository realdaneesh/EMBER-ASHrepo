{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/ember-ash/backend.log",
            "log_group_name": "/ember-ash/backend",
            "log_stream_name": "{instance_id}-app",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/ember-ash/backend.error.log",
            "log_group_name": "/ember-ash/backend",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/nginx/ember_ash_error.log",
            "log_group_name": "/ember-ash/nginx",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/ember-ash/nginx",
            "log_stream_name": "{instance_id}-main-error",
            "retention_in_days": 7
          }
        ]
      }
    },
    "log_stream_name": "{instance_id}"
  },
  "metrics": {
    "namespace": "EmberAsh/Backend",
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      }
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    }
  }
}
