# -----------------------------------------------------------------------------
# Ember & Ash - Backend Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# NOTE: Never commit .env or sensitive credentials to Git.
# -----------------------------------------------------------------------------

# Server Runtime
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated list for CORS)
# Example for production: https://main.d123456789.amplifyapp.com,https://emberandash.com
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ember_and_ash_db?retryWrites=true&w=majority

# Amazon SES Configuration (Reservation Acknowledgements & Order Confirmations)
# On Amazon EC2, authentication uses the EC2 instance profile IAM role (EmberAshEC2Role).
# No AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY is required in production.
AWS_REGION=ap-south-1
SES_FROM_EMAIL=daneeshshetty@gmail.com
SES_ENABLED=false

# Amazon SES Sandbox Mode
# Set to 'true' while SES is in Sandbox mode to enforce recipient allowlist checks
SES_SANDBOX_MODE=true

# Test Recipient Allowlist for Sandbox Mode
# Comma-separated list of verified destination email addresses or domains permitted during sandbox testing
# The verified sender (SES_FROM_EMAIL) and SES simulator addresses are always automatically included.
SES_ALLOWED_RECIPIENTS=daneeshshetty@gmail.com,success@simulator.amazonses.com

# Admin API Key for protected endpoints (e.g., GET /api/orders)
# Generate a secure 32+ character random string for production
ADMIN_API_KEY=change-this-to-a-secure-random-token-in-production

# Optional DNS configuration (only set to true if troubleshooting local Windows SRV resolution)
# ENABLE_CUSTOM_DNS=false
# CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1
